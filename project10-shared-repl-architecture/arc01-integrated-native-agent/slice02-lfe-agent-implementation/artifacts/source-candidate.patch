+;;;; Native Cayrn application boundary.
+(defmodule cayrn_lfe_app
+  (behaviour application)
+  (export (start 2) (stop 1)))
+
+(defspec (start 2)
+  (((call 'application 'start_type) (term))
+   (UNION (tuple 'ok (pid)) (tuple 'error (term)))))
+
+(defun start (_type _args)
+  "Start the native supervision tree without legacy xrepl services."
+  (cayrn_lfe_sup:start_link))
+
+(defspec (stop 1) (((term)) 'ok))
+
+(defun stop (_state)
+  "Finish application shutdown after the supervision tree stops."
+  'ok)
diff --git a/apps/cayrn_lfe/src/cayrn_lfe_sup.lfe b/apps/cayrn_lfe/src/cayrn_lfe_sup.lfe
new file mode 100644
--- /dev/null
+++ b/apps/cayrn_lfe/src/cayrn_lfe_sup.lfe
@@ -0,0 +1,32 @@
+;;;; Supervision for the listener and disposable native contexts.
+(defmodule cayrn_lfe_sup
+  (behaviour supervisor)
+  (export (context 1) (init 1) (start_link 0)))
+
+(defspec (context 1) (((port)) (call 'supervisor 'startchild_ret)))
+
+(defun context (socket)
+  "Start a temporary context; a failed environment is never restarted."
+  (supervisor:start_child (MODULE)
+    (map 'id (make_ref)
+         'start (tuple 'cayrn_lfe_context 'start_link (list socket))
+         'restart 'temporary 'shutdown 2000)))
+
+(defspec (init 1)
+  (((nil)) (tuple 'ok (tuple (call 'supervisor 'sup_flags)
+                             (list (call 'supervisor 'child_spec))))))
+
+(defun init (_args)
+  "Keep the listener and its contexts in the same failure domain."
+  (tuple 'ok
+    (tuple (map 'strategy 'one_for_all 'intensity 3 'period 10)
+      (list (map 'id 'cayrn_lfe_listener
+                 'start (tuple 'cayrn_lfe_listener 'start_link '())
+                 'restart 'permanent 'shutdown 2000)))))
+
+(defspec (start_link 0)
+  (() (UNION (tuple 'ok (pid)) (tuple 'error (term)))))
+
+(defun start_link ()
+  "Start the registered native supervisor."
+  (supervisor:start_link (tuple 'local (MODULE)) (MODULE) '()))
diff --git a/apps/cayrn_lfe/src/cayrn_lfe_listener.lfe b/apps/cayrn_lfe/src/cayrn_lfe_listener.lfe
new file mode 100644
--- /dev/null
+++ b/apps/cayrn_lfe/src/cayrn_lfe_listener.lfe
@@ -0,0 +1,75 @@
+;;;; Private socket listener; Rust remains the durable session authority.
+(defmodule cayrn_lfe_listener
+  (behaviour gen_server)
+  (export (handle_call 3) (handle_cast 2) (handle_info 2)
+          (init 1) (start_link 0) (terminate 2)))
+
+(defspec (start_link 0)
+  (() (UNION (tuple 'ok (pid)) (tuple 'error (term)))))
+
+(defun start_link ()
+  "Start the registered native socket listener."
+  (gen_server:start_link (tuple 'local (MODULE)) (MODULE) '() '()))
+
+(defspec (init 1)
+  (((nil)) (UNION (tuple 'ok (map)) (tuple 'stop (term)))))
+
+(defun init (_args)
+  "Create the native identity guard and private framed Unix listener."
+  (ets:new 'cayrn_lfe_contexts
+    '(named_table public set #(write_concurrency true)))
+  (let (((tuple 'ok path) (application:get_env 'cayrn_lfe 'socket)))
+    (case (gen_tcp:listen 0
+            (list 'binary '#(active false) '#(packet 4)
+                  '#(packet_size 262144) (tuple 'ifaddr (tuple 'local path))
+                  '#(backlog 64)))
+      ((tuple 'ok socket)
+       (let (('ok (file:change_mode path #o600)))
+         (! (self) 'accept)
+         (tuple 'ok (map 'socket socket 'path path))))
+      (error (tuple 'stop error)))))
+
+(defspec (handle_info 2) (((term) (map)) (tuple 'noreply (map))))
+
+(defun handle_info
+  "Accept bounded contexts and transfer socket ownership before activation."
+  (('accept (= (map 'socket listener) state))
+   (case (gen_tcp:accept listener 100)
+     ((tuple 'ok socket)
+      (let ((counts (supervisor:count_children 'cayrn_lfe_sup)))
+        (if (=< (proplists:get_value 'active counts) 64)
+          (case (cayrn_lfe_sup:context socket)
+            ((tuple 'ok pid)
+             (let (('ok (gen_tcp:controlling_process socket pid)))
+               (! pid 'activate)))
+            (_ (gen_tcp:close socket)))
+          (gen_tcp:close socket))))
+     ((tuple 'error 'timeout) 'ok)
+     ((tuple 'error 'closed) (exit 'listener_closed))
+     ((tuple 'error reason) (exit reason)))
+   (! (self) 'accept)
+   (tuple 'noreply state))
+  ((_ state) (tuple 'noreply state)))
+
+(defspec (handle_call 3)
+  (((term) (call 'gen_server 'from) (map))
+   (tuple 'reply (term) (map))))
+
+(defun handle_call (_request _from state)
+  "Reject unsupported synchronous requests."
+  (tuple 'reply '#(error unsupported) state))
+
+(defspec (handle_cast 2) (((term) (map)) (tuple 'noreply (map))))
+
+(defun handle_cast (_request state)
+  "Ignore unsupported asynchronous requests."
+  (tuple 'noreply state))
+
+(defspec (terminate 2) (((term) (map)) 'ok))
+
+(defun terminate
+  "Release only the listener's owned endpoint."
+  ((_reason (map 'socket socket 'path path))
+   (gen_tcp:close socket)
+   (file:delete path)
+   'ok))
diff --git a/apps/cayrn_lfe/src/cayrn_lfe_io.lfe b/apps/cayrn_lfe/src/cayrn_lfe_io.lfe
new file mode 100644
--- /dev/null
+++ b/apps/cayrn_lfe/src/cayrn_lfe_io.lfe
@@ -0,0 +1,51 @@
+;;;; Immutable operation attribution, including output from late writers.
+(defmodule cayrn_lfe_io
+  (export (loop 2) (start 2)))
+
+(defspec (start 2) (((pid) (binary)) (pid)))
+
+(defun start (owner operation)
+  "Start linked capture with one immutable operation identity."
+  (spawn_link (MODULE) 'loop (list owner operation)))
+
+(defspec (loop 2) (((pid) (binary)) (no_return)))
+
+(defun loop (owner operation)
+  "Run the native I/O protocol until its owner terminates it."
+  (loop owner operation 'false))
+
+(defun loop (owner operation closed)
+  (receive
+    ((tuple 'seal incoming-owner) (when (=:= incoming-owner owner))
+     (! owner (tuple 'sealed (self)))
+     (loop owner operation 'true))
+    ((tuple 'io_request from ref _) (when (=:= closed 'true))
+     (! from (tuple 'io_reply ref (tuple 'error 'terminated)))
+     (loop owner operation closed))
+    ((tuple 'io_request from ref request)
+     (case (output request)
+       ((tuple 'ok text) (when (=< (byte_size text) 8192))
+        (! owner (tuple 'capture from ref operation text)))
+       ((tuple 'ok _)
+        (! from (tuple 'io_reply ref (tuple 'error 'emsgsize))))
+       ((tuple 'error reason)
+        (! from (tuple 'io_reply ref (tuple 'error reason)))))
+     (loop owner operation closed))
+    (_ (loop owner operation closed))))
+
+(defun output
+  (((tuple 'put_chars encoding chars)) (text chars encoding))
+  (((tuple 'put_chars chars)) (text chars 'unicode))
+  (((tuple 'put_chars encoding module function args))
+   (try (text (apply module function args) encoding)
+     (catch ((tuple _ _ _) (tuple 'error 'badarg)))))
+  (((tuple 'put_chars module function args))
+   (output (tuple 'put_chars 'unicode module function args)))
+  ((_) (tuple 'error 'enotsup)))
+
+(defun text (chars encoding)
+  (try
+    (case (unicode:characters_to_binary chars encoding 'utf8)
+      (bytes (when (is_binary bytes)) (tuple 'ok bytes))
+      (_ (tuple 'error 'badarg)))
+    (catch ((tuple _ _ _) (tuple 'error 'badarg)))))
diff --git a/apps/cayrn_lfe/src/cayrn_lfe_context.lfe b/apps/cayrn_lfe/src/cayrn_lfe_context.lfe
new file mode 100644
--- /dev/null
+++ b/apps/cayrn_lfe/src/cayrn_lfe_context.lfe
@@ -0,0 +1,232 @@
+;;;; One live native environment per Rust-owned agent connection.
+(defmodule cayrn_lfe_context
+  (behaviour gen_server)
+  (export (handle_call 3) (handle_cast 2) (handle_info 2)
+          (init 1) (start_link 1) (terminate 2)))
+
+(defspec (start_link 1)
+  (((port)) (UNION (tuple 'ok (pid)) (tuple 'error (term)))))
+
+(defun start_link (socket)
+  "Start a context on its socket; no native reconnection or replay."
+  (gen_server:start_link (MODULE) socket '()))
+
+(defspec (init 1) (((port)) (tuple 'ok (map) (timeout))))
+
+(defun init (socket)
+  "Create an opaque evaluator environment and bounded capture/control state."
+  (process_flag 'trap_exit 'true)
+  (tuple 'ok
+    (map 'socket socket 'identity 'undefined 'env (cayrn-lfe-eval:new)
+         'active 'undefined 'seen (map) 'ios '() 'pending (map)
+         'seq 0 'closing 'undefined)
+    5000))
+
+(defspec (handle_info 2)
+  (((term) (map))
+   (UNION (tuple 'noreply (map)) (tuple 'noreply (map) (timeout))
+           (tuple 'stop (term) (map)))))
+
+(defun handle_info
+  "Process native control, evaluator and capture events in mailbox order."
+  (('activate (= (map 'socket socket) state))
+   (let (('ok (inet:setopts socket '(#(active once)))))
+     (tuple 'noreply state 5000)))
+  (((tuple 'tcp socket bytes) (= (map 'socket socket) state))
+   (try
+     (case (command (json:decode bytes) state)
+       ((tuple 'continue next)
+        (let (('ok (inet:setopts socket '(#(active once)))))
+          (tuple 'noreply next)))
+       ((tuple 'stop next) (tuple 'stop 'normal next)))
+     (catch ((tuple _ _ _) (tuple 'stop 'invalid_agent_command state)))))
+  (((tuple 'capture from ref operation text) state)
+   (let ((pending (map-get state 'pending)))
+     (if (< (map_size pending) 64)
+       (let* ((n (+ (map-get state 'seq) 1))
+              (position (integer_to_binary n)))
+         (let (('ok (send-event state
+                      (map 'kind 'output 'operation operation
+                           'position position 'text text))))
+           (tuple 'noreply
+             (map-set state 'seq n
+               'pending (map-set pending position (tuple from ref))))))
+       (progn
+         (! from (tuple 'io_reply ref '#(error enobufs)))
+         (tuple 'stop 'capture_overflow state)))))
+  (((tuple 'evaluated pid operation status text env)
+    (= (map 'active (tuple pid monitor operation)) state))
+   (erlang:demonitor monitor '(flush))
+   (let* (('true (=< (byte_size text) 8192))
+         ('ok (send-event state
+                (map 'kind 'outcome 'operation operation
+                     'phase status 'value text))))
+     (transition
+       (progress (map-set state 'active 'undefined 'env env)))))
+  (((tuple 'DOWN monitor 'process pid _reason)
+    (= (map 'active (tuple pid monitor operation) 'closing mode) state))
+   (when (orelse (=:= mode 'close) (=:= mode 'cancel)))
+   (let (('ok (send-event state
+                (map 'kind 'outcome 'operation operation 'phase 'cancelled
+                     'value #b("native evaluator terminated; "
+                               "environment discarded")))))
+     (transition (progress (map-set state 'active 'undefined)))))
+  (((tuple 'DOWN monitor 'process pid reason)
+    (= (map 'active (tuple pid monitor _)) state))
+   (tuple 'stop (tuple 'evaluator_lost reason) state))
+  (((tuple 'sealed io) (= (map 'waiting waiting) state))
+   (transition
+     (progress (map-set state 'waiting (lists:delete io waiting)))))
+  (('close_timeout (= (map 'closing mode) state))
+   (when (=/= mode 'undefined))
+   (let (('ok (send-event state
+                (map 'kind 'lost
+                     'reason #b("native close/interrupt incomplete: producer "
+                                "or capture barrier timed out")))))
+     (tuple 'stop 'normal state)))
+  (((tuple 'tcp_closed _) state) (tuple 'stop 'normal state))
+  (((tuple 'tcp_error _ reason) state) (tuple 'stop reason state))
+  (('timeout (= (map 'identity 'undefined) state))
+   (tuple 'stop 'handshake_timeout state))
+  (((tuple 'EXIT _ reason) state)
+   (tuple 'stop (tuple 'io_lost reason) state))
+  ((_ state) (tuple 'noreply state)))
+
+(defun command
+  (((map #b("kind") #b("hello") #b("version") 1
+         #b("session") sid #b("generation") generation
+         #b("authority") authority)
+    (= (map 'identity 'undefined) state))
+   (let* (('true (andalso (valid-id? sid) (valid-id? generation)
+                         (valid-id? authority)))
+         ('true (< (ets:info 'cayrn_lfe_contexts 'size) 4096))
+         ('true (ets:insert_new 'cayrn_lfe_contexts
+                  (tuple sid generation authority)))
+         ('ok (send-event state
+                (map 'kind 'ready 'version 1 'backend #b("lfe")
+                     'interrupt #b("session_destructive")
+                     'close_barrier 'true))))
+     (tuple 'continue
+       (map-set state 'identity (tuple sid generation authority)))))
+  (((map #b("kind") #b("dispatch") #b("operation") operation
+         #b("source") source #b("generation") generation
+         #b("authority") authority)
+    (= (map 'identity (tuple _ generation authority)
+            'active 'undefined 'seen seen 'closing 'undefined) state))
+   (when (is_binary source) (=< (byte_size source) 8192)
+         (< (map_size seen) 256))
+   (let* (('true (valid-id? operation))
+         ('false (maps:is_key operation seen)))
+     (let* ((owner (self))
+            (io (cayrn_lfe_io:start owner operation))
+            (env (map-get state 'env))
+            ((tuple pid monitor)
+             (spawn_monitor
+               (lambda ()
+                 (receive
+                   ('evaluate
+                    (let* (((tuple status value next)
+                            (cayrn-lfe-eval:run source env))
+                           (phase (case status
+                                    ('ok 'succeeded)
+                                    ('error 'failed))))
+                      (! owner (tuple 'evaluated (self) operation
+                                      phase value next)))))))))
+       (let* (('true (group_leader io pid)))
+         (! pid 'evaluate)
+         (tuple 'continue
+           (map-set state 'active (tuple pid monitor operation)
+                    'seen (map-set seen operation 'true)
+                    'ios (cons io (map-get state 'ios))))))))
+  (((map #b("kind") #b("ack") #b("position") position) state)
+   (let* (((tuple (tuple from ref) pending)
+           (maps:take position (map-get state 'pending))))
+     (! from (tuple 'io_reply ref 'ok))
+     (progress (map-set state 'pending pending))))
+  (((map #b("kind") #b("close"))
+    (= (map 'closing 'undefined) state))
+   (begin-stop 'close state))
+  (((map #b("kind") #b("close")) state) (tuple 'continue state))
+  (((map #b("kind") #b("cancel") #b("operation") operation)
+    (= (map 'active (tuple _ _ operation) 'closing 'undefined) state))
+   (begin-stop 'cancel state))
+  (((map #b("kind") #b("cancel") #b("operation") operation)
+    (= (map 'active 'undefined 'seen seen 'closing 'undefined) state))
+   (if (maps:is_key operation seen)
+     (tuple 'continue state)
+     (let (('ok (send-event state
+                  (map 'kind 'lost
+                       'reason #b("interrupt won before native dispatch; "
+                                  "context retired")))))
+       (tuple 'stop state))))
+  (((map #b("kind") #b("cancel")) state) (tuple 'continue state))
+  (((map #b("kind") #b("stop")) state) (tuple 'stop state))
+  ((_ _) (error 'invalid_agent_command)))
+
+(defun begin-stop (mode state)
+  (erlang:send_after 5000 (self) 'close_timeout)
+  (case (map-get state 'active)
+    ((tuple pid _ _) (exit pid 'kill))
+    ('undefined 'ok))
+  (progress (map-set state 'closing mode)))
+
+(defun progress
+  (((= (map 'closing 'cancel 'active 'undefined) state))
+   (let (('ok (send-event state
+                (map 'kind 'lost
+                     'reason #b("session-destructive interruption ended "
+                                "native context; capture tail may be "
+                                "uncertain")))))
+     (tuple 'stop state)))
+  (((= (map 'closing 'close 'active 'undefined) state))
+   (case (maps:find 'waiting state)
+     ('error
+      (let ((ios (map-get state 'ios)))
+        (lists:foreach (lambda (pid) (! pid (tuple 'seal (self)))) ios)
+        (progress (map-set state 'waiting ios))))
+     ((tuple 'ok '())
+      (if (=:= (map_size (map-get state 'pending)) 0)
+        (let (('ok (send-event state (map 'kind 'closed))))
+          (tuple 'stop state))
+        (tuple 'continue state)))
+     (_ (tuple 'continue state))))
+  ((state) (tuple 'continue state)))
+
+(defun transition
+  (((tuple 'continue state)) (tuple 'noreply state))
+  (((tuple 'stop state)) (tuple 'stop 'normal state)))
+
+(defun valid-id?
+  ((id) (when (is_binary id) (> (byte_size id) 0)
+              (=< (byte_size id) 128))
+   (=:= (re:run id #b("^[A-Za-z0-9_-]+$") '(#(capture none))) 'match))
+  ((_) 'false))
+
+(defun send-event
+  (((map 'socket socket) data)
+   (gen_tcp:send socket (json:encode data))))
+
+(defspec (handle_call 3)
+  (((term) (call 'gen_server 'from) (map))
+   (tuple 'reply (term) (map))))
+
+(defun handle_call (_request _from state)
+  "Reject unsupported synchronous requests."
+  (tuple 'reply '#(error unsupported) state))
+
+(defspec (handle_cast 2) (((term) (map)) (tuple 'noreply (map))))
+
+(defun handle_cast (_request state)
+  "Ignore unsupported asynchronous requests."
+  (tuple 'noreply state))
+
+(defspec (terminate 2) (((term) (map)) 'ok))
+
+(defun terminate (_reason state)
+  "Stop only this context's evaluator, capture servers and socket."
+  (case (map-get state 'active)
+    ((tuple pid _ _) (exit pid 'kill))
+    ('undefined 'ok))
+  (lists:foreach (lambda (pid) (exit pid 'kill)) (map-get state 'ios))
+  (gen_tcp:close (map-get state 'socket))
+  'ok)
diff --git a/apps/cayrn_lfe/test/cayrn_lfe_eval_tests.lfe b/apps/cayrn_lfe/test/cayrn_lfe_eval_tests.lfe
new file mode 100644
--- /dev/null
+++ b/apps/cayrn_lfe/test/cayrn_lfe_eval_tests.lfe
@@ -0,0 +1,40 @@
+;;;; Native evaluator persistence and error semantics.
+(defmodule cayrn_lfe_eval_tests
+  (export (errors_preserve_committed_environment_test 0)
+          (functions_and_macro_context_test 0)
+          (ordinary_error_atom_is_a_value_test 0)
+          (persistent_bindings_test 0)))
+
+(include-lib "eunit/include/eunit.hrl")
+
+(defun persistent_bindings_test ()
+  "Keep bindings across separate evaluations."
+  (let* ((env (cayrn-lfe-eval:new))
+         ((tuple 'ok #b("41") next)
+          (cayrn-lfe-eval:run #b("(set x 41)") env)))
+    (assertMatch (tuple 'ok #b("42") _)
+      (cayrn-lfe-eval:run #b("(+ x 1)") next))))
+
+(defun errors_preserve_committed_environment_test ()
+  "Preserve the committed environment across parse and evaluation errors."
+  (let* (((tuple 'ok _ env)
+          (cayrn-lfe-eval:run #b("(set x 41)") (cayrn-lfe-eval:new)))
+         ((tuple 'error _ after-eval)
+          (cayrn-lfe-eval:run #b("(/ 1 0)") env))
+         ((tuple 'error _ after-parse) (cayrn-lfe-eval:run #b("(") env)))
+    (assertEqual env after-eval)
+    (assertEqual env after-parse)
+    (assertMatch (tuple 'ok #b("41") _) (cayrn-lfe-eval:run #b("x") env))))
+
+(defun functions_and_macro_context_test ()
+  "Retain a top-level function in the native environment."
+  (let (((tuple 'ok _ env)
+         (cayrn-lfe-eval:run #b("(defun inc (x) (+ x 1))")
+           (cayrn-lfe-eval:new))))
+    (assertMatch (tuple 'ok #b("42") _)
+      (cayrn-lfe-eval:run #b("(inc 41)") env))))
+
+(defun ordinary_error_atom_is_a_value_test ()
+  "Return the ordinary error atom as a value, not an evaluation failure."
+  (assertMatch (tuple 'ok #b("error") _)
+    (cayrn-lfe-eval:run #b("'error") (cayrn-lfe-eval:new))))
diff --git a/apps/cayrn_lfe/test/cayrn_lfe_io_tests.lfe b/apps/cayrn_lfe/test/cayrn_lfe_io_tests.lfe
new file mode 100644
--- /dev/null
+++ b/apps/cayrn_lfe/test/cayrn_lfe_io_tests.lfe
@@ -0,0 +1,65 @@
+;;;; Capture ACK and sealing negative controls.
+(defmodule cayrn_lfe_io_tests
+  (export (capture_requires_owner_ack_test 0)
+          (native_agent_companions_test_ 0)
+          (seal_orders_prior_capture_and_rejects_late_writes_test 0)))
+
+(include-lib "eunit/include/eunit.hrl")
+
+;; Rebar discovers Erlang test files, while LFE companion discovery starts here.
+;; Include the evaluator and isolated-startup modules explicitly in the suite.
+(defun native_agent_companions_test_ ()
+  "Discover all native cases without depending on Erlang source files."
+  (list '#(module cayrn_lfe_eval_tests)
+        '#(module cayrn_lfe_application_tests)))
+
+(defun capture_requires_owner_ack_test ()
+  "Never acknowledge a native write before its owner commits capture."
+  (let ((io (cayrn_lfe_io:start (self) #b("operation")))
+        (ref (make_ref)))
+    (try
+      (progn
+        (! io (tuple 'io_request (self) ref
+                     (tuple 'put_chars 'unicode #b("hello"))))
+        (receive
+          ((tuple 'capture from incoming-ref #b("operation") #b("hello"))
+           (when (=:= incoming-ref ref))
+           (assertEqual (self) from))
+          (after 1000 (error 'missing_capture)))
+        (receive
+          ((tuple 'io_reply incoming-ref _)
+           (when (=:= incoming-ref ref))
+           (error 'false_native_ack))
+          (after 20 'ok)))
+      (after
+        (unlink io)
+        (exit io 'kill)))))
+
+(defun seal_orders_prior_capture_and_rejects_late_writes_test ()
+  "Seal after earlier capture and reject subsequent writes explicitly."
+  (let ((io (cayrn_lfe_io:start (self) #b("origin")))
+        (ref (make_ref)))
+    (try
+      (progn
+        (! io (tuple 'io_request (self) ref
+                     (tuple 'put_chars 'unicode #b("before"))))
+        (! io (tuple 'seal (self)))
+        (receive
+          (first
+           (assertEqual (tuple 'capture (self) ref #b("origin") #b("before"))
+             first))
+          (after 1000 (error 'missing_capture)))
+        (receive
+          (second (assertEqual (tuple 'sealed io) second))
+          (after 1000 (error 'missing_seal)))
+        (let ((later (make_ref)))
+          (! io (tuple 'io_request (self) later
+                       (tuple 'put_chars 'unicode #b("after"))))
+          (receive
+            ((tuple 'io_reply incoming-ref reply)
+             (when (=:= incoming-ref later))
+             (assertEqual '#(error terminated) reply))
+            (after 1000 (error 'missing_late_rejection)))))
+      (after
+        (unlink io)
+        (exit io 'kill)))))
