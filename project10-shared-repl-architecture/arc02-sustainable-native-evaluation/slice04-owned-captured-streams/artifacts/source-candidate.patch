+              (progn
+                (lists:foreach
+                  (lambda (token)
+                    (dispatch socket token
+                      #b("(let ((root (self))) "
+                         "(lists:foreach (lambda (_) (spawn (lambda () "
+                         "(io:request (group_leader) (tuple 'put_chars "
+                         "'unicode 'cayrn_lfe_ownership_tests 'held-mfa "
+                         "(list root)))))) (lists:seq 1 32)) 'scheduled)"))
+                    (assertEqual #b("succeeded")
