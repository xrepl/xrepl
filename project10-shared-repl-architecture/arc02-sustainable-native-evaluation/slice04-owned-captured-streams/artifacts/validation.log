                  (cayrn_lfe_context:handle_info
                    (tuple 'DOWN (make_ref) 'process worker 'normal)
                    prepared)))
              (after (exit io 'kill) (exit worker 'kill))))))) '(false true))
  (lists:foreach
    (lambda (down-first)
      (with-handler-state
        (lambda (state)
          (let* ((ref (make_ref))
                 (monitor (map-get state 'writer-monitor))
                 (prepared (map-set state 'closing 'close
