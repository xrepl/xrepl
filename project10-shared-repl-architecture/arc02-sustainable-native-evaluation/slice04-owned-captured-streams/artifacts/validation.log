(defun publishing_deferred_controls_test ()
  "One consumed deferred token cannot run before sent or after Close/Cancel."
  (lists:foreach
    (lambda (control)
      (with-handler-state
        (lambda (state)
          (let* ((ref (make_ref)) (marker (marker-path))
                 (source (iolist_to_binary
