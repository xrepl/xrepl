from pathlib import Path
import tempfile,socket,struct,json,uuid,subprocess,time
r=Path('/Users/oubiwann/lab/lfe/xrepl/xrepl');d=Path(tempfile.mkdtemp(prefix='cayrn-x03-root launch ',dir='/private/tmp'));path=d/'agent socket.sock';plog=d/'process.log';f=plog.open('w');p=subprocess.Popen([str(r/'bin/cayrn-lfe'),str(path)],cwd='/private/tmp',stdout=f,stderr=subprocess.STDOUT)
print('ACTUAL ROOT LAUNCHER',str(r/'bin/cayrn-lfe'),str(path),'CWD /private/tmp',flush=True)
def send(s,data):
 b=json.dumps(data).encode();s.sendall(struct.pack('!I',len(b))+b);print('SEND',json.dumps(data),flush=True)
def exact(s,n):
 b=b''
 while len(b)<n:
  v=s.recv(n-len(b));assert v,'unexpected EOF';b+=v
 return b
def read(s):
 n=struct.unpack('!I',exact(s,4))[0];assert n<=262144;v=json.loads(exact(s,n));print('RECV',json.dumps(v),flush=True);return v
def connect():
 s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(3);s.connect(str(path));return s
try:
 end=time.monotonic()+10
 while not path.exists():
  assert p.poll() is None
  if time.monotonic()>end:raise TimeoutError('native startup')
  time.sleep(.01)
 with connect() as authority:
  aid=str(uuid.uuid4());send(authority,dict(kind='authority_hello',version=4,authority=aid));grant=read(authority);assert grant['kind']=='authority_ready' and grant['version']==4
  with connect() as context:
   scope=dict(boot=grant['boot'],lease=grant['lease'],ticket='1');send(context,dict(kind='hello',version=4,session='root-smoke',generation='g',authority=aid,**scope));ready=read(context);assert ready['kind']=='ready' and ready['version']==4 and all(ready[k]==v for k,v in scope.items())
   for op,source,expected in [('1','(+ 20 22)','42'),('2','(lists:sort (lists:map (lambda (entry) (element 1 entry)) (application:which_applications)))','(cayrn_lfe compiler crypto kernel lfe stdlib)')]:
    send(context,dict(kind='dispatch',operation=op,source=source,generation='g',authority=aid));result=read(context);assert result['kind']=='outcome' and result['phase']=='succeeded' and result['value']==expected and result['preview']=={'truncated':False}
   send(context,dict(kind='close'));assert read(context)['kind']=='closed'
finally:
 p.terminate()
 try:p.wait(timeout=5)
 except subprocess.TimeoutExpired:p.kill();p.wait()
 f.close();print('PROCESS OUTPUT\n'+plog.read_text(),flush=True);print('OWNED PROCESS EXIT',p.returncode,flush=True)
 if path.exists():path.unlink()
 plog.unlink();d.rmdir()
assert p.returncode==0
print('ROOT LAUNCHER ALL ORACLES PASS',flush=True)
VERBATIM END

