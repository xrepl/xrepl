from pathlib import Path
import subprocess,sys,hashlib,json,os
r=Path('/Users/oubiwann/lab/lfe/xrepl/xrepl');a=r/'.worktrees/planning/project10-shared-repl-architecture/arc02-sustainable-native-evaluation/slice03-bounded-result-previews/artifacts'
label=sys.argv[1];cwd=Path(sys.argv[2]);args=sys.argv[3:];env=os.environ.copy()
for k in ['CAYRN_LFE_DIR','XREPL_DIR','XREPL_BIN','CARGO_TARGET_DIR']:env.pop(k,None)
files=json.loads((a/'source-baseline.json').read_text())['before']
def hashes():return {p:hashlib.sha256((r/p).read_bytes()).hexdigest() if (r/p).exists() else None for p in files}
before=hashes()
with (a/'validation.log').open('a') as f:
 f.write('\n## '+label+'\nCWD '+str(cwd)+'\nARGV '+repr(args)+'\nOVERRIDES UNSET CAYRN_LFE_DIR XREPL_DIR XREPL_BIN CARGO_TARGET_DIR\nSOURCE15 BEFORE '+json.dumps(before,sort_keys=True)+'\n');f.flush()
 p=subprocess.run(args,cwd=cwd,env=env,stdout=f,stderr=subprocess.STDOUT)
 after=hashes();f.write('\nEXIT '+str(p.returncode)+'\nSOURCE15 AFTER '+json.dumps(after,sort_keys=True)+'\nUNCHANGED '+str(before==after)+'\n')
print(label,'EXIT',p.returncode,'source unchanged',before==after)
if p.returncode:
 print((a/'validation.log').read_text()[-4500:])
assert before==after
raise SystemExit(p.returncode)
VERBATIM END

