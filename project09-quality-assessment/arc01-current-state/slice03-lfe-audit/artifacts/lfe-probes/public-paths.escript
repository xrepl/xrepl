#!/usr/bin/env escript
-mode(compile).
main(_) ->
    Root = "/Users/oubiwann/lab/lfe/xrepl/xrepl",
    Paths = filelib:wildcard(Root ++ "/_build/default/lib/*/ebin") ++ filelib:wildcard(Root ++ "/_build/default/checkouts/*/ebin"),
    code:add_pathsa(Paths),
    application:load(xrepl),
    lists:foreach(fun({K,V}) -> application:set_env(xrepl,K,V) end,
      [{history_enabled,false},{history_file,"/private/tmp/xrepl-p09-neutral-probe/history"},{network_enabled,false},{tcp_enabled,false},{unix_enabled,false}]),
    {ok,_} = application:ensure_all_started(xrepl),
    io:format("OTP=~s LFE=~p~n", [erlang:system_info(otp_release),application:get_key(lfe,vsn)]),
    {ok,S} = 'xrepl-session-manager':create(#{metadata => #{neutral_custom => true}}),
    io:format("metadata_requested_custom=~p metadata_actual=~p~n",[true,'xrepl-store':'get-metadata'(S)]),
    io:format("sequential_control=~p~n",['xrepl-session':eval(S,"(+ 1 2)")]),
    Parent = self(), Name = 'xrepl-session':'process-name'(S),
    A = spawn(fun() -> Parent ! {a,catch 'xrepl-session':eval(S,"(progn (timer:sleep 250) 'first)")} end),
    wait_pending(Name,100),
    B = spawn(fun() -> Parent ! {b,catch 'xrepl-session':eval(S,"'second")} end),
    io:format("concurrent_reply1=~p~n",[receive X={_,_} -> X after 6000 -> timeout end]),
    io:format("concurrent_reply2=~p~n",[receive Y={_,_} -> Y after 6000 -> timeout end]),
    io:format("callers_finished=~p~n",[not is_process_alive(A) andalso not is_process_alive(B)]),
    io:format("after_concurrent_sequential=~p~n",['xrepl-session':eval(S,"(+ 2 3)")]),
    {ok,C} = 'xrepl-session-manager':create(),
    io:format("set_before_close=~p~n",['xrepl-session':eval(C,"(set neutral_keep 12345)")]),
    ok = 'xrepl-session-manager':close(C), ok = 'xrepl-session-manager':reopen(C),
    io:format("close_reopen_without_explicit_save=~p~n",['xrepl-session':eval(C,"neutral_keep")]),
    'xrepl-session':eval(C,"(set neutral_keep 67890)"), 'xrepl-session':'save-state'(C),
    'xrepl-session-manager':close(C), 'xrepl-session-manager':reopen(C),
    io:format("explicit_save_control=~p~n",['xrepl-session':eval(C,"neutral_keep")]),
    {ok,E} = 'xrepl-session-manager':create(),
    'xrepl-store':'update-session'(E,fun(D)->D#{timeout => -1000} end),
    Count = 'xrepl-store':'cleanup-expired-sessions'(),
    io:format("expiry_count=~p lookup=~p active=~p eval=~p~n",[Count,'xrepl-store':'get-session'(E),'xrepl-session-manager':'is-active?'(E),'xrepl-session':eval(E,"(+ 5 6)")]),
    Utf8=unicode:characters_to_binary([8212]),
    {Resp,_}='xrepl-dispatcher':'handle-message'(#{op=>eval,code=>['quote',{formatted,Utf8}]},S,true,stdio),
    io:format("formatted_utf8_expected=~p actual=~p equal=~p~n",[Utf8,maps:get(value,Resp),Utf8=:=maps:get(value,Resp)]),
    Wire=unicode:characters_to_binary("(length \"" ++ [955] ++ "\")"),
    {WireResp,_}='xrepl-dispatcher':'handle-message'(#{op=>eval,code=>Wire},S,true,tcp),
    io:format("wire_unicode_length_expected1=~p~n",[WireResp]),
    io:format("malformed_message=~p~n",[catch 'xrepl-dispatcher':'handle-message'(42,S,true,tcp)]),
    io:format("unknown_op_control=~p~n",['xrepl-dispatcher':'handle-message'(#{op=><<"neutral_unknown">>},S,true,tcp)]),
    io:format("env_public_get_bindings=~p~n",[catch 'xrepl-env':'get-bindings'('xrepl-session':'get-env'(S))]),
    lists:foreach(fun(Id)->'xrepl-session-manager':destroy(Id) end,[S,C,E]),
    halt(0).
wait_pending(_,0)->error(no_pending);
wait_pending(Name,N)->case element(6,sys:get_state(Name)) of undefined->timer:sleep(2),wait_pending(Name,N-1);_->ok end.
